generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CurrencyType {
  A
  B

  @@map("currency_type")
}

enum Bulletin {
  opening
  intermediate
  closing

  @@map("bulletin")
}

enum SyncStatus {
  success
  failure

  @@map("sync_status")
}

model Currency {
  code      String          @id
  name      String
  type      CurrencyType
  quotes    CurrencyQuote[]
  syncState SyncState?

  @@map("currencies")
}

model CurrencyQuote {
  currencyCode String   @map("currency_code")
  quotedAt     DateTime @map("quoted_at") @db.Timestamptz(6)
  bulletin     Bulletin
  quoteDate    DateTime @map("quote_date") @db.Date
  bid          Decimal  @db.Decimal(20, 8)
  ask          Decimal  @db.Decimal(20, 8)
  bidParity    Decimal  @map("bid_parity") @db.Decimal(20, 8)
  askParity    Decimal  @map("ask_parity") @db.Decimal(20, 8)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  currency     Currency @relation(fields: [currencyCode], references: [code])

  @@id([currencyCode, quotedAt, bulletin])
  @@map("currency_quotes")
}

model SyncState {
  currencyCode        String      @id @map("currency_code")
  lastAttemptAt       DateTime?   @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime?   @map("last_success_at") @db.Timestamptz(3)
  lastStatus          SyncStatus? @map("last_status")
  lastError           String?     @map("last_error")
  lastObservationDate DateTime?   @map("last_observation_date") @db.Date
  currency            Currency    @relation(fields: [currencyCode], references: [code])

  @@map("sync_state")
}
