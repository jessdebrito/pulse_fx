{
  "name": "pulse-fx",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse FX — câmbio (BRL) e indicadores macro a partir de BCB e FRED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "prisma": true,
    "@prisma/engines": true
  }
}
